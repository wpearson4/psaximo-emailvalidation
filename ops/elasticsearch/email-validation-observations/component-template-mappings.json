        "maxAttempts": { "type": "integer" },
        "durationMilliseconds": { "type": "long" },
        "strategyVersion": { "type": "keyword", "ignore_above": 64 },
        "classificationVersion": { "type": "keyword", "ignore_above": 64 },
        "policyVersion": { "type": "keyword", "ignore_above": 64 },
        "previousLifecycleState": { "type": "keyword", "ignore_above": 64 },
        "lifecycleState": { "type": "keyword", "ignore_above": 64 },
        "previousHealthState": { "type": "keyword", "ignore_above": 64 },
        "healthState": { "type": "keyword", "ignore_above": 64 },
        "cooldownUntilUtc": { "type": "date" },
        "failureCount": { "type": "integer" },
        "healthPolicyVersion": { "type": "keyword", "ignore_above": 64 }
