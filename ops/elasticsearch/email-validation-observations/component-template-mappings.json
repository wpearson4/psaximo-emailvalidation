        "recordedAtUtc": { "type": "date" },
        "occurredAtUtc": { "type": "date" },
        "eventId": { "type": "keyword", "ignore_above": 128 },
        "eventType": { "type": "keyword", "ignore_above": 128 },
        "schemaVersion": { "type": "keyword", "ignore_above": 32 },
        "mappingVersion": { "type": "keyword", "ignore_above": 32 },
        "environment": { "type": "keyword", "ignore_above": 64 },
        "tenantId": { "type": "keyword", "ignore_above": 128 },
        "consumerId": { "type": "keyword", "ignore_above": 128 },
        "validationId": { "type": "keyword", "ignore_above": 128 },
        "jobId": { "type": "keyword", "ignore_above": 128 },
        "sequence": { "type": "long" },
        "lifecycleSequence": { "type": "long" },
        "attemptNumber": { "type": "integer" },
        "emailCorrelationId": { "type": "keyword", "ignore_above": 128 },
        "emailHashKeyVersion": { "type": "keyword", "ignore_above": 32 },
        "recipientDomain": { "type": "keyword", "ignore_above": 253 },
        "provider": { "type": "keyword", "ignore_above": 64 },
        "providerClassificationSource": { "type": "keyword", "ignore_above": 256 },
        "providerConfidence": { "type": "scaled_float", "scaling_factor": 10000 },
        "mxFingerprint": { "type": "keyword", "ignore_above": 256 },
        "mxHost": { "type": "keyword", "ignore_above": 253 },
        "status": { "type": "keyword", "ignore_above": 64 },
        "subStatus": { "type": "keyword", "ignore_above": 128 },
        "resultState": { "type": "keyword", "ignore_above": 64 },
        "resultSource": { "type": "keyword", "ignore_above": 128 },
        "confidence": { "type": "scaled_float", "scaling_factor": 10000 },
        "verificationReliability": { "type": "scaled_float", "scaling_factor": 10000 },
        "resultStability": { "type": "keyword", "ignore_above": 64 },
        "catchAllState": { "type": "keyword", "ignore_above": 64 },
        "roleAddressState": { "type": "keyword", "ignore_above": 64 },
        "outboundIdentityId": { "type": "keyword", "ignore_above": 128 },
        "sourceIp": { "type": "ip" },
        "ehloHostName": { "type": "keyword", "ignore_above": 253 },
