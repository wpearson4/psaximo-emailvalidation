FROM alpine:3.22.5

RUN apk add --no-cache \
      ca-certificates \
      postfix \
      postsrsd \
    && newaliases

COPY deploy/mail-forwarder/virtual /etc/postfix/virtual
RUN postmap lmdb:/etc/postfix/virtual

COPY deploy/mail-forwarder/main.cf /etc/postfix/main.cf
COPY deploy/mail-forwarder/postsrsd.conf /etc/postsrsd/postsrsd.conf
COPY deploy/mail-forwarder/entrypoint.sh /usr/local/bin/mail-forwarder-entrypoint

RUN postconf -c /etc/postfix -n >/dev/null \
    && chmod 0755 /usr/local/bin/mail-forwarder-entrypoint \
    && install -d -o postsrsd -g postsrsd -m 0700 /var/lib/postsrsd

EXPOSE 25

HEALTHCHECK --interval=30s --timeout=6s --retries=3 --start-period=15s \
  CMD postfix status >/dev/null 2>&1 \
    && nc -z 127.0.0.1 25 \
    && nc -z 127.0.0.1 10003

ENTRYPOINT ["/usr/local/bin/mail-forwarder-entrypoint"]
