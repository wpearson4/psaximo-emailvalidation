{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "EmailValidation": "Information"
    }
  },
  "EmailValidation": {
    "Dns": {
      "TimeoutSeconds": 5,
      "RetryCount": 1,
      "CacheMinutes": 60
    },
    "Smtp": {
      "Enabled": true,
      "ConnectionTimeoutSeconds": 10,
      "CommandTimeoutSeconds": 10,
      "RetryCount": 1,
      "GlobalConcurrency": 2,
      "PerDomainConcurrency": 1,
      "PerProviderConcurrency": 2,
      "DelayBetweenDomainRequestsMilliseconds": 500,
      "GreylistingRetryDelayMilliseconds": 2000,
      "MaxMxAttempts": 3,
      "MaxSmtpSessionsPerAddress": 8,
      "ProbeSenderHealthCacheMinutes": 60
    },
    "Scheduling": {
      "GlobalConcurrency": 8,
      "PerDomainConcurrency": 1,
      "PerProviderConcurrency": 2,
      "DomainMinIntervalMilliseconds": 1500,
      "DomainIntervalJitterMilliseconds": 250,
      "ProviderMinIntervalMilliseconds": 0,
      "MaxActiveDomains": 1000,
      "TemporaryFailureBackoffMilliseconds": 5000,
      "MaximumBackoffMilliseconds": 120000
    },
    "ProbeSenderSource": {
      "Provider": "Elasticsearch",
      "Endpoint": "https://elasticsearch.example-owned-domain.com:9200",
      "Index": "authorized-probe-senders",
      "EmailField": "business_email",
      "QueryLimit": 500,
      "RefreshThreshold": 100,
      "RefreshIntervalSeconds": 300,
      "StaleAfterMinutes": 30,
      "RecentlyUsedLimit": 1000,
      "Query": {
        "bool": {
          "filter": [
            { "exists": { "field": "business_email" } }
          ]
        }
      }
    },
    "ProbeSenderRotation": {
      "MaxValidationsPerSender": 50,
      "MaxActiveMinutes": 15,
      "MaxSenderAttemptsPerValidation": 2,
      "SenderCooldownSeconds": 300,
      "JitterPercent": 20,
      "MinimumSuccessRateSampleSize": 10,
      "MinimumMailFromSuccessRate": 0.8,
      "SenderAffinityMinutes": 60,
      "RotateOnSenderSpecificFailure": true,
      "SenderCompatibilityMinutes": 60
    },
    "CatchAll": {
      "Enabled": true,
      "ProbeCount": 1,
      "MinimumAcceptedProbes": 2,
      "MaxProbeCount": 3,
      "CacheMinutes": 1440,
      "MinimumReusableConfidence": 0.90
    },
    "Intelligence": {
      "RoleAccounts": [
        "info",
        "support",
        "admin",
        "sales",
        "billing",
        "contact",
        "help",
        "office",
        "marketing",
        "webmaster"
      ],
      "DisposableDomains": [
        "10minutemail.com",
        "guerrillamail.com",
        "mailinator.com",
        "temp-mail.org",
        "yopmail.com",
        "trashmail.com"
      ],
      "FreeEmailDomains": [
        "gmail.com",
        "googlemail.com",
        "outlook.com",
        "hotmail.com",
        "live.com",
        "msn.com",
        "yahoo.com",
        "aol.com",
        "icloud.com",
        "me.com",
        "proton.me",
        "protonmail.com",
        "fastmail.com"
      ],
      "CommonDomainTypos": {
        "gmal.com": "gmail.com",
        "gmial.com": "gmail.com",
        "hotmial.com": "hotmail.com",
        "outlok.com": "outlook.com"
      },
      "ToxicDomains": [],
      "KnownSpamTrapAddresses": [],
      "AbuseRiskAddresses": [],
      "SuppressedAddresses": {},
      "MxForwardingSuffixes": {}
    }
  }
}
