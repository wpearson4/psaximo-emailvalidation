{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "EmailValidation": "Information"
    }
  },
  "EmailValidation": {
    "Dns": {
      "TimeoutSeconds": 5,
      "RetryCount": 1,
      "CacheMinutes": 60
    },
    "Smtp": {
      "Enabled": true,
      "ProbeSender": "",
      "ProbeSenders": [
        {
          "Address": "probe1@verify.example-owned-domain.com",
          "Enabled": true
        },
        {
          "Address": "probe2@verify.example-owned-domain.com",
          "Enabled": true
        }
      ],
      "ConnectionTimeoutSeconds": 10,
      "CommandTimeoutSeconds": 10,
      "RetryCount": 1,
      "GlobalConcurrency": 2,
      "PerDomainConcurrency": 1,
      "PerProviderConcurrency": 2,
      "DelayBetweenDomainRequestsMilliseconds": 500,
      "GreylistingRetryDelayMilliseconds": 2000,
      "MaxMxAttempts": 3,
      "MaxSenderAttemptsPerValidation": 2,
      "MaxSmtpSessionsPerAddress": 8,
      "SenderCooldownSeconds": 300,
      "ProbeSenderHealthCacheMinutes": 60
    },
    "CatchAll": {
      "Enabled": true,
      "ProbeCount": 1,
      "MinimumAcceptedProbes": 2,
      "MaxProbeCount": 3,
      "CacheMinutes": 1440
    },
    "Intelligence": {
      "RoleAccounts": [
        "info",
        "support",
        "admin",
        "sales",
        "billing",
        "contact",
        "help",
        "office",
        "marketing",
        "webmaster"
      ],
      "DisposableDomains": [
        "10minutemail.com",
        "guerrillamail.com",
        "mailinator.com",
        "temp-mail.org",
        "yopmail.com",
        "trashmail.com"
      ],
      "FreeEmailDomains": [
        "gmail.com",
        "googlemail.com",
        "outlook.com",
        "hotmail.com",
        "live.com",
        "msn.com",
        "yahoo.com",
        "aol.com",
        "icloud.com",
        "me.com",
        "proton.me",
        "protonmail.com",
        "fastmail.com"
      ],
      "CommonDomainTypos": {
        "gmal.com": "gmail.com",
        "gmial.com": "gmail.com",
        "hotmial.com": "hotmail.com",
        "outlok.com": "outlook.com"
      },
      "ToxicDomains": [],
