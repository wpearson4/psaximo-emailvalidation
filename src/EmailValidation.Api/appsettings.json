{
  "Azure": {
    "AppConfigurationEnabled": true,
    "AppConfigurationEndpoint": "https://appcs-p-ometa-dsi-scus.azconfig.io",
    "AppConfigurationLabel": "Production"
  },
  "Authentication": {
    "Authority": "https://identity.example.invalid",
    "Audience": "emailvalidation-api",
    "RequireHttpsMetadata": true
  },
  "Api": {
    "Limits": {
      "MaximumRequestBodyBytes": 1048576,
      "MaximumEmailLength": 320,
      "MaximumIdentifierLength": 128,
      "MaximumIdempotencyKeyLength": 128,
      "DefaultJobResultPageSize": 100
    },
    "RateLimiting": {
      "PermitLimit": 120,
      "WindowSeconds": 60,
      "QueueLimit": 0,
      "StreamConcurrencyLimit": 20
    },
    "Cors": {
      "AllowedOrigins": []
    },
    "OpenApi": {
      "ExposeInProduction": false,
      "AuthorizationUrl": "",
      "TokenUrl": "",
      "SwaggerClientId": ""
    },
    "OpenMeta": {
      "BaseUrl": "http://127.0.0.1:5058"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://0.0.0.0:8081",
        "Protocols": "Http2"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "EmailValidation": "Information"
    }
  },
  "AllowedHosts": "*"
}
