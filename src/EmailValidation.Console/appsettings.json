{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "EmailValidation": "Information"
    }
  },
  "EmailValidation": {
    "Dns": {
      "TimeoutSeconds": 5,
      "RetryCount": 1,
      "CacheMinutes": 60
    },
    "Smtp": {
      "Enabled": true,
      "ConnectionTimeoutSeconds": 10,
      "CommandTimeoutSeconds": 10,
      "RetryCount": 1,
      "GlobalConcurrency": 2,
      "PerDomainConcurrency": 1,
      "PerProviderConcurrency": 2,
      "DelayBetweenDomainRequestsMilliseconds": 500,
      "GreylistingRetryDelayMilliseconds": 2000,
      "MaxMxAttempts": 3,
      "MaxSmtpSessionsPerAddress": 8,
      "ProbeSenderHealthCacheMinutes": 60
    },
    "Scheduling": {
      "GlobalConcurrency": 8,
      "PerDomainConcurrency": 1,
      "PerProviderConcurrency": 2,
      "DomainMinIntervalMilliseconds": 1500,
      "DomainIntervalJitterMilliseconds": 250,
      "ProviderMinIntervalMilliseconds": 0,
      "MaxActiveDomains": 1000,
      "TemporaryFailureBackoffMilliseconds": 5000,
      "MaximumBackoffMilliseconds": 120000,
      "DefaultProviderPolicy": {
        "PerProviderConcurrency": 2,
        "DelayMilliseconds": 1000,
        "PolicyBlockCooldownMinutes": 15,
        "MaxRetries": 1
      },
      "ProviderPolicies": {
        "Yahoo": {
          "PerProviderConcurrency": 1,
          "DelayMilliseconds": 2500,
          "PolicyBlockCooldownMinutes": 30,
          "MaxRetries": 1
        },
        "Microsoft": {
          "PerProviderConcurrency": 1,
          "DelayMilliseconds": 3000,
          "PolicyBlockCooldownMinutes": 60,
          "MaxRetries": 1
        },
        "Google": {
          "PerProviderConcurrency": 1,
          "DelayMilliseconds": 2000,
          "PolicyBlockCooldownMinutes": 30,
          "MaxRetries": 1
        }
      }
    },
    "ProbeSenderSource": {
      "Provider": "Elasticsearch",
      "Endpoint": "http://10.10.252.28:9200",
      "Index": "zi-b2b",
      "EmailField": "business_email",
      "QueryLimit": 500,
      "RefreshThreshold": 100,
      "RefreshIntervalSeconds": 300,
      "StaleAfterMinutes": 30,
      "RecentlyUsedLimit": 1000,
      "Username": "",
      "Password": "",
      "ApiKey": "",
      "Query": {
        "bool": {
          "filter": [
            {
              "term": {
                "business_email_validation_status": "valid (catch-all)"
              }
            },
            {
              "exists": {
                "field": "business_email"
              }
            }
          ]
        }
      }
    },
    "ProbeSenderRotation": {
      "MaxValidationsPerSender": 50,
      "MaxActiveMinutes": 15,
      "MaxSenderAttemptsPerValidation": 2,
      "SenderCooldownSeconds": 300,
      "JitterPercent": 20,
      "MinimumSuccessRateSampleSize": 10,
      "MinimumMailFromSuccessRate": 0.8,
      "SenderAffinityMinutes": 60,
      "RotateOnSenderSpecificFailure": true,
      "SenderCompatibilityMinutes": 60
    },
    "CatchAll": {
      "Enabled": true,
      "ProbeCount": 1,
      "MinimumAcceptedProbes": 2,
      "MaxProbeCount": 3,
      "CacheMinutes": 1440
    },
    "Intelligence": {
      "RoleAccounts": [ "info", "support", "admin", "sales", "billing", "contact", "help", "office", "marketing", "webmaster" ],
      "DisposableDomains": [ "10minutemail.com", "guerrillamail.com", "mailinator.com", "temp-mail.org", "yopmail.com", "trashmail.com" ],
      "FreeEmailDomains": [ "gmail.com", "googlemail.com", "outlook.com", "hotmail.com", "live.com", "msn.com", "yahoo.com", "aol.com", "icloud.com", "me.com", "proton.me", "protonmail.com", "fastmail.com" ],
      "CommonDomainTypos": {
        "gmal.com": "gmail.com",
        "gmial.com": "gmail.com",
        "hotmial.com": "hotmail.com",
        "outlok.com": "outlook.com"
      },
      "ToxicDomains": [],
      "KnownSpamTrapAddresses": [],
      "AbuseRiskAddresses": [],
      "SuppressedAddresses": {},
      "MxForwardingSuffixes": {}
    }
  }
}
